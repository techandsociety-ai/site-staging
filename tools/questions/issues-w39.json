  },
  "suppression": "Groups under 10 respondents are withheld",
  "moe": "95% margins, worked out as in the Work report's Table 8: 1.96 × √(p(1 − p) / n) on the unweighted n. They leave out the effect of weighting, so true margins are somewhat wider; the MCP doesn't serve its own yet (#273). States rest on {nLo} to {nHi} respondents each, an age group within a state on as few as {cellMin}. Groups under 100 are starred: interpret with caution.",
  "pulled": "Nov 10, 2026",
  "set_text": {
    "title": "What matters to the 2026 midterm vote, in every state",
    "subtitle": "Share of eligible adults (all but those who said they can't vote) who rate each issue 8 to 10, on a scale of 1 to 10, for their 2026 midterm vote",
    "answer": "rate {phrase} 8 to 10",
    "noun": "issues",
    "base": "eligible adults",
    "note": "Wave 39 from the survey team's final release of Nov. 6, 2026. Not for publication.",
    "across": {
      "us_title": "What matters most to eligible U.S. adults' 2026 midterm vote",
      "state_title": "{place} across {count} midterm issues",
      "subtitle": "Share of eligible {place} adults who rate each issue 8 to 10 for their midterm vote, fall 2026"
    },
    "note_label": "Not for publication",
    "item": "Issue",
    "context": "context-w39"
  },
  "template": {
    "topic": "The 2026 midterms",
    "question": "How important is {phrase} to your 2026 midterm vote?",
    "dek": "{usPct} of eligible U.S. adults rate {phrase} 8 to 10 for their 2026 midterm vote.",
    "wording": "How important are the following issues for your decision on how to vote in the 2026 midterm election? Please rate their importance on a scale from 1 to 10, where 1 is “Not important at all” and 10 is “Extremely important”. — {option} (shown here: 8 to 10)",
    "provenance": [
      "create_recoded_variable(name=\"issue_high_…\", source_column=\"{column}\", mapping 1–7 → 0, 8–10 → 1, binary=true) → {recode}",
      "generate_crosstab(platform=\"{recode}\", demographic=\"age_cat_4\", data_source=\"w39\")",
      "generate_crosstab_multi(variable=\"{recode}\", demographics=[\"state\", \"age_cat_4\"], data_source=\"w39\"); U.S. and state totals summed from these cells"
    ],
    "text": {
      "age": {
        "us": {
          "title": "Who rates {phrase} 8 to 10, by age",
          "subtitle": "Share of eligible U.S. adults who rate {phrase} 8 to 10 for their 2026 midterm vote, by age, fall 2026",
          "source": "CHIP50 survey, {wave}, {fielded}. {usN} eligible U.S. adults, weighted to the adult population."
        },
        "state": {
          "title": "{value} of eligible {state} adults rate {phrase} 8 to 10",
          "subtitle": "Share who rate {phrase} 8 to 10 for their 2026 midterm vote, by age, fall 2026. Ticks mark the U.S.",
          "source": "CHIP50 survey, {wave}, {fielded}. {n} eligible adults in {state}, weighted within the state; U.S. ticks from all {usN}."
        }
      },
      "states": {
        "title": "{label}: {lo} to {hi} rate it 8 to 10 across states",
        "subtitle": "Share of eligible adults who rate {phrase} 8 to 10 for their 2026 midterm vote, by state, fall 2026. U.S.: {us}",
        "source": "CHIP50 survey, {wave}, {fielded}. {usN} eligible adults, {nLo} to {nHi} per state, weighted within each state."
      },
      "radio": {
        "us": "{usWords} of American adults eligible to vote say {phrase} is very important to how they'll vote in the midterms — 8 or higher on a 10-point scale — according to a CHIP50 survey this fall.",
        "state": "In {state}, {words} of eligible adults rate {phrase} 8 or higher for importance to their midterm vote, compared with {usWords} nationally. That's from the CHIP50 survey, which reached {n} adults in {state} this fall."
      }
    }
