{
  "set": "trust-w39",
  "site": "techandsociety.ai",
  "by": {
    "column": "age_cat_4",
    "name": "age",
    "order": [
      "18 to 24",
      "25 to 44",
      "45 to 64",
      "65 and over"
    ]
  },
  "wave": "Wave 39",
  "fielded": "Oct 1 to 26, 2026 (preliminary release)",
  "weight": {
    "us": "weight: the survey team's demographic weight",
    "state": "weight_state: demographics, calibrated within each state"
  },
  "suppression": "Groups under 10 respondents are withheld; none were",
  "moe": "95% margins, worked out as in the Work report's Table 8: 1.96 × √(p(1 − p) / n) on the unweighted n. They leave out the effect of weighting, so true margins are somewhat wider; the MCP doesn't serve its own yet (#273). States rest on {nLo} to {nHi} respondents each, an age group within a state on as few as {cellMin}. Groups under 100 are starred: interpret with caution.",
  "pulled": "Oct 26, 2026",
  "set_text": {
    "title": "Trust in every institution, in every state",
    "subtitle": "Share of adults who trust each to do what is right some or a lot (of not at all, not too much, some, a lot)",
    "answer": "trust {phrase} some or a lot",
    "noun": "institutions",
    "base": "adults",
    "across": {
      "us_title": "Whom U.S. adults trust to do what is right",
      "state_title": "{place} across {count} institutions",
      "subtitle": "Share of {place} adults who trust each some or a lot, fall 2026"
    },
    "note": "Preliminary Wave 39 release: fielding ran to Oct. 26 and the survey team's final file may differ. Not for publication until it lands.",
    "note_label": "Preliminary"
  },
  "template": {
    "topic": "Trust",
    "question": "Do you trust {phrase} to do what is right?",
    "dek": "{usPct} of U.S. adults trust {phrase} some or a lot.",
    "wording": "How much do you trust the following people and organizations to do what is right? — {option} (Not at all, Not too much, Some, A lot; shown here: Some or A lot)",
    "provenance": [
      "create_recoded_variable(name=\"trust_some_…\", source_column=\"{column}\", mapping={\"1\": \"0\", \"2\": \"0\", \"3\": \"1\", \"4\": \"1\"}, binary=true) → {recode}",
      "generate_crosstab(platform=\"{recode}\", demographic=\"age_cat_4\", data_source=\"w39\")",
      "generate_crosstab_multi(variable=\"{recode}\", demographics=[\"state\", \"age_cat_4\"], data_source=\"w39\"); U.S. and state totals summed from these cells"
    ],
    "text": {
      "age": {
        "us": {
          "title": "Who trusts {phrase}, by age",
          "subtitle": "Share of U.S. adults who trust {phrase} some or a lot, by age, fall 2026",
          "source": "CHIP50 survey, {wave}, {fielded}. {usN} U.S. adults, weighted to the adult population."
        },
        "state": {
          "title": "{value} of {state} adults trust {phrase} some or a lot",
          "subtitle": "Share who trust {phrase} some or a lot, by age, fall 2026. Ticks mark the U.S.",
          "source": "CHIP50 survey, {wave}, {fielded}. {n} adults in {state}, weighted within the state; U.S. ticks from all {usN}."
        }
      },
      "states": {
        "title": "Trust in {phrase}: {lo} to {hi} across states",
        "subtitle": "Share of adults who trust {phrase} some or a lot, by state, fall 2026. U.S.: {us}",
        "source": "CHIP50 survey, {wave}, {fielded}. {usN} adults, {nLo} to {nHi} per state, weighted within each state."
      },
      "radio": {
        "us": "{usWords} of American adults say they trust {phrase} at least some to do what is right, according to a CHIP50 survey this fall.",
        "state": "In {state}, {words} of adults say they trust {phrase} at least some to do what is right, compared with {usWords} nationally. That's from the CHIP50 survey, which reached {n} adults in {state} this fall."
      }
    }
  },
